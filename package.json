{
  "name": "nitrate",
  "version": "2.0.0",
  "private": true,
  "description": "A social film diary and Movie Club platform: your films, their films, our films.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.38.4",
    "next": "^15.5.23",
    "postgres": "3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "drizzle-kit": "0.30.2",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "8.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "5.0.0"
  }
}
