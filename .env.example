# ---------------------------------------------------------------------------
# Nitrate — environment
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# Postgres. Use the pooled (transaction mode) URL for the app runtime.
DATABASE_URL="postgresql://user:password@host:6543/postgres"
# Session-mode / direct URL, used only for migrations (supports DDL + prepared statements).
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 32+ byte random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# TMDB (https://www.themoviedb.org/settings/api).
# Either the v4 Read Access Token (preferred, starts with "eyJ") or a v3 API key.
TMDB_API_KEY=""

# Optional: pin the movie metadata provider. "tmdb" (default) or "offline".
MOVIE_PROVIDER="tmdb"

# Outbound email (https://resend.com). Without a key, mail still queues and is
# visible in the admin outbox, but is printed to the log instead of sent.
RESEND_API_KEY=""
# Must be a domain verified with your email provider.
EMAIL_FROM="Nitrate <movienight@yourdomain.com>"

# Shared secret for the weekly-pick cron endpoint. Vercel Cron sends this
# automatically as a bearer token when set as a project env var.
CRON_SECRET=""

# Public site origin, used for invite links and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
